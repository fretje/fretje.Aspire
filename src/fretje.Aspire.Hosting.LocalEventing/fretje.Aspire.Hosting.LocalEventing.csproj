<Project Sdk="fretje.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>

    <PackageId>fretje.Aspire.Hosting.LocalEventing</PackageId>
    <Description>Local Event Grid emulator and blob storage event proxy for Aspire. Enables local development of Azure Functions blob EventGrid triggers by proxying Azurite blob traffic and forwarding events to a local Event Grid emulator.</Description>
    <PackageTags>aspire;azure;storage;blob;eventgrid;emulator;local-development</PackageTags>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="fretje.Aspire.Hosting.LocalEventing.Tests" />
  </ItemGroup>

</Project>
